# Cosecre Hub configuration.
#
# Copy to .env and edit. Every value here is a default the hub already uses, so
# an empty .env is a valid one — these are the knobs, not requirements.
#
# The prefix is COSECRE_ (not COSECRE_HUB_) on purpose: an existing
# backend/.env can be copied across unchanged.

# ── Server ───────────────────────────────────────────────────────────────────
COSECRE_HOST=0.0.0.0
COSECRE_PORT=8000
# 0 disables idle shutdown locally; Fly uses 600 (10 minutes).
# When enabled, run: uv run python -m cosecre_hub.server
COSECRE_IDLE_TIMEOUT_SECONDS=0

# ── Identity ─────────────────────────────────────────────────────────────────
# Signs every access token. The hub logs a warning on each start until this is
# changed; until then, tokens can be forged. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
COSECRE_SECRET_KEY=replace-this-in-production

COSECRE_ACCESS_TOKEN_TTL_MINUTES=30
COSECRE_REFRESH_TOKEN_TTL_DAYS=30

# Leave false unless you want anyone who can reach this hub to create an account.
# Registration is open regardless while the hub has zero users, so the first
# admin can always be bootstrapped.
COSECRE_ALLOW_OPEN_REGISTRATION=false

# Set both to create the first admin (or reset its password) on startup. This is
# the recommended way in, and the way back after a lockout.
COSECRE_BOOTSTRAP_ADMIN_EMAIL=
COSECRE_BOOTSTRAP_ADMIN_PASSWORD=

# Legacy seed file. Holds PLAINTEXT passwords — keep it out of version control.
# Prefer the two variables above plus admin-managed accounts (POST /users).
# COSECRE_SEED_USERS_FILE=./seed_users.json

# ── Storage ──────────────────────────────────────────────────────────────────
# Any SQLAlchemy URL. Point this at backend/data/cosecre.db to adopt an existing
# deployment's data — the hub adds its own columns on startup.
COSECRE_DATABASE_URL=sqlite:///./data/cosecre.db
COSECRE_UPLOAD_DIR=./data/uploads

# ── Models ───────────────────────────────────────────────────────────────────
# Without a key, /api/v1/llm/* answers 503 and GET /meta reports llm: false.
COSECRE_OPENAI_API_KEY=
COSECRE_OPENAI_MODEL=gpt-6-luna
# Sent as the Responses API reasoning.effort. Blank omits the field, which is
# what non-reasoning models need.
COSECRE_OPENAI_REASONING_EFFORT=medium

# TypeSafe's Jev: a second opinion on document type, payment status and method.
# Optional — without a key the vision model decides alone. Keys: console.typesafe.ai/keys
COSECRE_TYPESAFE_API_KEY=
COSECRE_JEV_MODEL=jev-latest
# Documents read at once. Reading is mostly waiting on the model API; a
# migration uses all slots but one, so live photos never queue behind it.
COSECRE_EXTRACTION_CONCURRENCY=4

# ── Google Sheets / Drive (documents module) ──────────────────────────────────
# Share the target spreadsheet with the service account's email address.
COSECRE_GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
# One folder for every document, named <yyyy-mm-dd>_<number>. Falls back to the
# invoices folder below when empty.
COSECRE_GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=
# The two folders of the invoice/ticket era. Only read as fallbacks now.
COSECRE_GOOGLE_DRIVE_INVOICES_FOLDER_ID=
COSECRE_GOOGLE_DRIVE_TICKETS_FOLDER_ID=
# Optional off-site copy of every backup. Share the folder with the service account.
COSECRE_GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# The caixeta d'efectiu sheet (statements module), used until one is set in Configuració.
COSECRE_CAIXETA_SPREADSHEET_URL=

# ── Backups ──────────────────────────────────────────────────────────────────
# Daily, and before an idle shutdown if anything changed. The folder defaults to
# `backups/` next to a SQLite database — on Fly, the persistent volume.
# COSECRE_BACKUP_DIR=./data/backups
COSECRE_BACKUP_KEEP=30
COSECRE_BACKUP_INTERVAL_HOURS=24

# ── CORS ─────────────────────────────────────────────────────────────────────
# The defaults already allow localhost dev ports, LAN addresses, and the
# `file://` / `null` origins a packaged Electron renderer sends. Override only
# to pin the hub to specific public origins.
# COSECRE_CORS_ORIGIN_REGEX=^https://(app|hub)\.example\.com$
