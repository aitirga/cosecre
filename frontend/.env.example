# Where the dev server binds. 0.0.0.0 makes it reachable from other devices on
# the LAN, which is how the phone camera capture gets tested.
COSECRE_FRONTEND_HOST=0.0.0.0
COSECRE_FRONTEND_PORT=5173

# The Cosecre Hub that `/api` is proxied to. Proxying keeps the browser on one
# origin in development, so there is no CORS to configure.
COSECRE_HUB_URL=http://127.0.0.1:8000

# Only needed when the built app is served from a different origin than its hub
# — in the normal deployment they share one, and `/api/v1` resolves by itself.
# VITE_API_BASE_URL=https://hub.example.com/api/v1
